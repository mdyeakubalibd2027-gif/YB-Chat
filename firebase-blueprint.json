{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 30 },
        "email": { "type": "string", "maxLength": 100 },
        "avatar": { "type": "string", "maxLength": 500000 },
        "about": { "type": "string", "maxLength": 300 },
        "password": { "type": "string", "maxLength": 100 },
        "isOnline": { "type": "boolean" },
        "lastSeen": { "type": "string", "maxLength": 60 },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "name"]
    },
    "Chat": {
      "title": "Chat",
      "description": "Direct and group conversation threads",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "type": { "type": "string", "enum": ["direct", "group"] },
        "name": { "type": "string", "maxLength": 100 },
        "avatar": { "type": "string", "maxLength": 500000 },
        "description": { "type": "string", "maxLength": 500 },
        "participants": { "type": "array" },
        "admins": { "type": "array" },
        "unreadCount": { "type": "number" },
        "isPinned": { "type": "boolean" },
        "lastMessageText": { "type": "string", "maxLength": 500 },
        "lastMessageTimestamp": { "type": "number" },
        "lastMessageSender": { "type": "string", "maxLength": 100 },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "type", "name", "participants"]
    },
    "Message": {
      "title": "Message",
      "description": "Individual chat message",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "chatId": { "type": "string", "maxLength": 128 },
        "senderId": { "type": "string", "maxLength": 128 },
        "senderName": { "type": "string", "maxLength": 100 },
        "text": { "type": "string", "maxLength": 5000 },
        "mediaType": { "type": "string", "enum": ["text", "image", "file", "audio"] },
        "mediaUrl": { "type": "string", "maxLength": 500000 },
        "mediaName": { "type": "string", "maxLength": 200 },
        "mediaSize": { "type": "string", "maxLength": 50 },
        "audioDuration": { "type": "number" },
        "timestamp": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "sent", "delivered", "read"] },
        "reaction": { "type": "string", "maxLength": 10 }
      },
      "required": ["id", "chatId", "senderId", "senderName", "timestamp", "status"]
    },
    "Story": {
      "title": "Story",
      "description": "User status update story",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 100 },
        "userAvatar": { "type": "string", "maxLength": 500000 },
        "type": { "type": "string", "enum": ["text", "image"] },
        "content": { "type": "string", "maxLength": 500000 },
        "caption": { "type": "string", "maxLength": 300 },
        "backgroundColor": { "type": "string", "maxLength": 50 },
        "timestamp": { "type": "number" }
      },
      "required": ["id", "userId", "userName", "type", "content", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/chats/{chatId}": {
      "schema": "Chat",
      "description": "Chat conversations"
    },
    "/messages/{messageId}": {
      "schema": "Message",
      "description": "Messages for chats"
    },
    "/stories/{storyId}": {
      "schema": "Story",
      "description": "User status stories"
    }
  }
}
